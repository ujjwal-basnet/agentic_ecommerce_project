# LLM / Vertex AI Gemini
# When GOOGLE_GENAI_USE_VERTEXAI=true (default), the SDK uses ADC from
# GOOGLE_APPLICATION_CREDENTIALS. GOOGLE_API_KEY is the fallback for the
# Gemini Developer API path (set GOOGLE_GENAI_USE_VERTEXAI=false for that).
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENWEATHER_API_KEY=

# Supabase Postgres. Keep this backend-only; never expose it to Next.js.
# Prefer the *direct* connection (db.<project>.supabase.co:5432) for a long-lived
# backend — the pooler adds a hop. Use the pooler only for serverless clients.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
DB_SSLMODE=require

PRODUCT_IMAGES_DIR=data/products
USER_UPLOADS_DIR=data/uploads
TRYON_DIR=data/tryon
CAMPAIGN_DIR=data/campaigns
PROTOCOL_LOG_PATH=logs/protocol_log.jsonl

# Remote MCP access token for Claude/Cursor/etc.
MCP_BEARER_TOKEN=

# Meta/Facebook/Instagram unified config
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=smartshop-webhook
# IMPORTANT: this MUST be a Page Access Token (not a User token) for posting
# to /{page_id}/photos, /{page_id}/feed, and IG /{ig_user_id}/media.
META_ACCESS_TOKEN=

FB_PAGE_ID=
# Optional: explicit Page Access Token. If set, overrides META_ACCESS_TOKEN
# for Page/IG post calls. Leave blank if META_ACCESS_TOKEN is already a Page token.
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v24.0

IG_USER_ID=

# Supabase Storage — product images, user uploads, try-on results, campaigns.
# Buckets are auto-created on startup. Free tier: 1 GB storage + 5 GB egress.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional fallback — serve local /data/campaigns/ through a public host (ngrok etc.)
# Only used when SUPABASE_URL is NOT set and Instagram needs a reachable image URL.
PUBLIC_BASE_URL=
