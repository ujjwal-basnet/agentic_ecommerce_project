# LLM / Vertex AI Gemini
# GOOGLE_GENAI_USE_VERTEXAI=true → uses ADC from GOOGLE_APPLICATION_CREDENTIALS.
# Set to false and provide GOOGLE_API_KEY to use the Gemini Developer API instead.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENWEATHER_API_KEY=

# Supabase Postgres.
# Prefer the direct connection (db.<project>.supabase.co:5432) over pooler —
# the pooler adds a hop and ~50-100 ms per query for a long-lived backend.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
DB_SSLMODE=require
PRODUCTS_MD_PATH=data/products.md

PRODUCT_IMAGES_DIR=data/products
USER_UPLOADS_DIR=data/uploads
TRYON_DIR=data/tryon
CAMPAIGN_DIR=data/campaigns
PROTOCOL_LOG_PATH=logs/protocol_log.jsonl

# App-level auth gate — protects all API routes behind username/password.
# Leave APP_USERNAME blank to disable the gate (local dev mode).
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
APP_USERNAME=
APP_PASSWORD_HASH=
JWT_SECRET=change-me-before-deploy
JWT_EXPIRY_HOURS=72

# Remote MCP access token for Claude/Cursor/etc.
MCP_BEARER_TOKEN=

# Meta/Facebook/Instagram
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=smartshop-webhook
# Must be a Page Access Token for /{page_id}/photos and IG /{ig_user_id}/media.
META_ACCESS_TOKEN=
FB_PAGE_ID=
# Optional: overrides META_ACCESS_TOKEN for Page/IG calls if set.
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v24.0
IG_USER_ID=

# Supabase Storage — buckets auto-created/upserted to public on startup.
# Free tier: 1 GB storage + 5 GB egress/month.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional fallback for IG image hosting when Supabase is not configured.
PUBLIC_BASE_URL=

# ── Email Receipts (optional SMTP) ─────────────────────────────────────
# Leave empty to disable. Works with Gmail (smtp.gmail.com), SendGrid, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
