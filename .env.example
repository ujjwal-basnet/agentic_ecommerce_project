# ── LLM backend (pydantic-ai reasoning) ─────────────────────────────────────
# Two supported setups — pick ONE.
#
# (A) OpenAI cloud (default, least ops, best reasoning):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#
# (B) Self-hosted vLLM on a T4 GPU (OpenAI-compatible; NO code change).
#     Run this ON THE T4 (Lightning AI / cloud) — a 7B AWQ needs ~16 GB VRAM,
#     it will NOT fit a 3 GB local GPU:
#         vllm serve Qwen/Qwen2.5-7B-Instruct-AWQ \
#           --quantization awq --dtype float16 --max-model-len 8192 \
#           --gpu-memory-utilization 0.90 \
#           --guided-decoding-backend xgrammar --port 8000
#     NOTE: use `awq` (not `awq_marlin`) and `float16` — the T4 is Turing (SM75),
#     it has no bf16 and no Marlin kernels (those need Ampere SM80+).
#     Then expose the port (Lightning URL / cloudflared / ngrok) and set:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://<t4-tunnel>/v1
# OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# OPENAI_API_KEY=EMPTY        # vLLM ignores it, but the OpenAI client needs a value
#     A smaller Qwen/Qwen2.5-3B-Instruct-GPTQ-Int4 fits a ~3 GB GPU for testing.
#     EMBEDDING_BASE_URL defaults to LLM_BASE_URL; vLLM won't serve embeddings so
#     the router's embedding fallback uses mock vectors (fine — the LLM intent
#     classifier is primary). Point it at a real embedder only if you want it live.

# Intent routing: LLM classifier first, embedding router as fallback. Set false
# for fully offline dev (no LLM reachable).
ROUTER_USE_LLM=true

# ── Groq (fast query rewriter — resolves context/pronouns before planner) ──
# Optional but strongly recommended. ~150ms per call. Uses Llama 3.1 8B.
GROQ_API=
GROQ_MODEL=llama-3.1-8b-instant

# ── RunPod (FLUX.1 Kontext — virtual try-on & campaign image editing) ─────
# $0.025/img at 1080p, $0.013/img at 720p. Best try-on quality.
RUNPOD_API_KEY=

# ── Pinecone (vector search) ───────────────────────────────────────────────
# Required for semantic product search (dual RAG vector path)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ecommerce
PINECONE_NAMESPACE=__default__
PINECONE_MEME_NAMESPACE=meme_assets

# ── Redis (semantic cache) ─────────────────────────────────────────────────
# Optional — if unavailable, caching is skipped gracefully
REDIS_URL=redis://localhost:6379

# ── Google Gemini (image generation only) ──────────────────────────────────
# GOOGLE_GENAI_USE_VERTEXAI=true → uses ADC from GOOGLE_APPLICATION_CREDENTIALS.
# Set to false and provide GOOGLE_API_KEY to use the Gemini Developer API instead.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENWEATHER_API_KEY=

# Supabase Postgres.
# Prefer the direct connection (db.<project>.supabase.co:5432) over pooler —
# the pooler adds a hop and ~50-100 ms per query for a long-lived backend.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
DB_SSLMODE=require
PRODUCTS_MD_PATH=data/products.md

PRODUCT_IMAGES_DIR=data/products
USER_UPLOADS_DIR=data/uploads
TRYON_DIR=data/tryon
CAMPAIGN_DIR=data/campaigns
MEME_ASSETS_DIR=data/memes
MEME_RAG_SOURCE_DIR=/home/ujjwal/meme_rag
MEME_SUPABASE_BUCKET=meme-assets
MEME_RAG_ENABLED=true
MEME_RAG_MIN_SCORE=0.10
PROTOCOL_LOG_PATH=logs/protocol_log.jsonl

# App-level auth gate — protects all API routes behind username/password.
# Leave APP_USERNAME blank to disable the gate (local dev mode).
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
APP_USERNAME=
APP_PASSWORD_HASH=
JWT_SECRET=change-me-before-deploy
JWT_EXPIRY_HOURS=72

# Remote MCP access token for Claude/Cursor/etc.
MCP_BEARER_TOKEN=
# Demo only: true disables MCP bearer auth so hosted Claude custom connectors can connect.
MCP_PUBLIC=false

# Meta/Facebook/Instagram
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=smartshop-webhook
# Must be a Page Access Token for /{page_id}/photos and IG /{ig_user_id}/media.
META_ACCESS_TOKEN=
FB_PAGE_ID=
# Optional: overrides META_ACCESS_TOKEN for Page/IG calls if set.
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v24.0
IG_USER_ID=

# Supabase Storage — buckets auto-created/upserted to public on startup.
# Free tier: 1 GB storage + 5 GB egress/month.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional fallback for IG image hosting when Supabase is not configured.
PUBLIC_BASE_URL=

# ── Email Receipts (optional SMTP) ─────────────────────────────────────
# Leave empty to disable. Works with Gmail (smtp.gmail.com), SendGrid, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Pydantic Logfire observability (get write token from https://logfire.pydantic.dev)
LOGFIRE_TOKEN=
