# LLM via Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENWEATHER_API_KEY=

DB_PATH=data/database.sqlite
PRODUCT_IMAGES_DIR=data/products
USER_UPLOADS_DIR=data/uploads
TRYON_DIR=data/tryon
PROTOCOL_LOG_PATH=logs/protocol_log.jsonl

# Meta/Facebook/Instagram unified config
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=smartshop-webhook
META_ACCESS_TOKEN=

FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v24.0
FB_VERIFY_TOKEN=smartshop-webhook

IG_USER_ID=
IG_VERIFY_TOKEN=smartshop-webhook

DM_AUTO_REPLY=Thanks for your message! We'll get back to you soon.
COMMENT_AUTO_REPLY=Thanks for your comment!

ENABLE_FB_MESSENGER=true
ENABLE_INSTAGRAM=true

CUSTOMER_API_URL=http://localhost:8000
OWNER_API_URL=http://localhost:8000
